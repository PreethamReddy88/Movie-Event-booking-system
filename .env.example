# ── Database ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/movie_booking
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/movie_booking

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT ──
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ──
APP_NAME=MovieBookingAPI
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
